{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "includeFiles": "{server.py,static/**}"
    }
  },
  "rewrites": [
    { "source": "/", "destination": "/api?__route=/" },
    { "source": "/(.*)", "destination": "/api?__route=/$1" }
  ]
}
