{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/config.py": {
      "maxDuration": 10,
      "includeFiles": "server.py",
      "excludeFiles": "{public/**,static/**,assets/**}"
    },
    "api/generate.py": {
      "maxDuration": 60,
      "includeFiles": "server.py",
      "excludeFiles": "{public/**,static/**,assets/**}"
    }
  }
}
